# Backend Database Connection String (Supabase / PostgreSQL)
# Supabase Pooler: DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase Direct: DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"


# JWT & Authentication Secrets
JWT_SECRET="project-loop-super-secret-jwt-key-2026-secure"

# Express Backend Settings
PORT=5000
NODE_ENV="production"
FRONTEND_URL="https://loop-ai-feedback-intelligence.vercel.app"

# Next.js Frontend Settings (Vercel)
BACKEND_URL="https://project-loop-backend.onrender.com"
NEXT_PUBLIC_BACKEND_URL="https://project-loop-backend.onrender.com"

# Optional AI Integration — Anthropic Claude API Key
ANTHROPIC_API_KEY="sk-ant-api03-your-anthropic-key"
